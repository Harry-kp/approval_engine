<% if @url.present? %>
  <p style="margin:24px 0 0;"><a href="<%= @url %>" style="display:inline-block; background:#4f46e5; color:#fff; text-decoration:none; padding:10px 18px; border-radius:8px; font-weight:600;">Review this approval</a></p>
<% else %>
  <p style="margin:24px 0 0; color:#64748b;">Open <%= Rails.application.class.module_parent_name %> to review it — no approval link is configured yet (see <code>config.approval_url_builder</code>).</p>
<% end %>
