<p style="margin:0 0 8px;">Changes were requested on <strong><%= @target_label %></strong><%= " by #{@actor_label}" if @actor_label.present? %>.</p>
<%= render partial: "details", formats: [ :html ] %>
<% if @comment.present? %>
  <blockquote style="margin:0 0 16px; padding:12px 16px; background:#f8fafc; border-left:3px solid #e2e8f0; color:#334155;"><%= @comment %></blockquote>
<% end %>
<%= render partial: "call_to_action", formats: [ :html ] %>
