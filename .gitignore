/.bundle/
/doc/
/log/*.log
/pkg/
/tmp/
/test/tmp/
/test/dummy/log/*.log
/test/dummy/storage/
/test/dummy/tmp/

# Built gems — produced by `gem build` / `rake build`, never committed.
*.gem

# A library resolves dependencies fresh; the lock isn't part of the gem repo.
/Gemfile.lock

# SimpleCov output.
/coverage/

# OS / editor cruft.
.DS_Store

# Agent worktrees created by tooling — never part of the repo.
/.claude/

# The dummy app's schema is dumped with whichever Rails ran the migration, which
# no older Rails in the CI matrix can read. Everything migrates from scratch.
/test/dummy/db/schema.rb
